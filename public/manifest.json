{
  "manifest_version": 3,
  "name": "Autofill My PDF",
  "short_name": "Autofill PDF",
  "version": "1.0.0",
  "description": "Enter your info once. Map it onto any PDF — BOLs, rate cons, trip sheets — then fill, sign, save and print in seconds.",
  "action": {
    "default_title": "Open Autofill My PDF",
    "default_icon": { "16": "icons/icon16.png", "32": "icons/icon32.png", "48": "icons/icon48.png", "128": "icons/icon128.png" }
  },
  "icons": { "16": "icons/icon16.png", "32": "icons/icon32.png", "48": "icons/icon48.png", "128": "icons/icon128.png" },
  "background": { "service_worker": "background.js", "type": "module" },
  "permissions": ["downloads", "unlimitedStorage"],
  "content_security_policy": {
    "extension_pages": "script-src 'self' 'wasm-unsafe-eval'; object-src 'self'"
  }
}
